<?php
/**
 * NSY — Config du proxy IA du chatbot (chat.php).
 *
 * Copier ce fichier en `_secret/ai.php` SUR LE SERVEUR et renseigner la clé.
 * `_secret/ai.php` est gitignoré et inaccessible en HTTP (_secret/.htaccess).
 *
 * Clé gratuite Mistral (recommandé — société française, données UE) :
 *   1. Créer un compte sur https://console.mistral.ai
 *   2. Choisir le plan « Experiment » (gratuit, vérification par téléphone)
 *   3. API Keys → Create new key → coller ci-dessous
 *
 * Le proxy parle le format OpenAI-compatible : pour basculer sur Groq
 * (gratuit aussi), il suffit de changer api_url + model :
 *   'api_url' => 'https://api.groq.com/openai/v1/chat/completions',
 *   'model'   => 'llama-3.3-70b-versatile',
 */

return [
    'api_url' => 'https://api.mistral.ai/v1/chat/completions',
    'api_key' => 'CHANGE_ME_SET_THE_MISTRAL_API_KEY',
    // Modèle principal, ÉPINGLÉ à une version précise (owner, 14/09/2026) : un
    // alias (…-latest) peut changer de moteur sous nos pieds. mistral-small
    // n'est plus servi sur le palier gratuit depuis le 13/09/2026 (limite à 0).
    'model'   => 'ministral-8b-2512',
    // Le palier gratuit a un pool de capacité PAR modèle (« Service tier
    // capacity exceeded ») : si le principal est saturé ou refusé, chat.php
    // bascule sur un AUTRE moteur — ministral-8b-latest et open-mistral-nemo
    // servent le même ministral-8b-2512, ils ne replient rien (surchargable ici).
    // 'fallback_models' => ['ministral-3b-latest'],
    // Quotas du rate-limiting (facultatif — valeurs par défaut du code sinon).
    // Ils ne vivent PAS dans le dépôt public : les publier, c'est publier la
    // limite exacte à ne pas dépasser pour épuiser le quota gratuit du modèle.
    'quotas' => [
        'ip_minute'     => 8,
        'ip_jour'       => 60,
        'global_minute' => 30,
        'global_jour'   => 1500,
    ],
];
