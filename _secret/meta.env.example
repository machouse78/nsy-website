# Publication automatique du journal sur la page Facebook NSY
# (scripts/meta-publish.mjs — cycle complet : skills/journal-nsy §3).
#
# → copier ce fichier vers _secret/meta.env puis suivre la VOIE SIMPLE.
#   meta.env est GITIGNORÉ et LOCAL UNIQUEMENT (jamais commité, jamais déployé —
#   prepare-deploy.sh ne le copie pas, comme ftp.env).
#
# ── VOIE SIMPLE : `setup` fait tout depuis un jeton court ─────────────────────
# 1. developers.facebook.com → app « Journal Auto Publisher » → Paramètres →
#    Général : copier « ID de l'app » et « Clé secrète » ci-dessous.
# 2. Graph API Explorer : générer un jeton UTILISATEUR (courte durée) avec
#    pages_show_list, pages_manage_posts, pages_manage_engagement,
#    pages_read_engagement — cocher la Page NSY dans la boîte de dialogue —
#    et le coller ci-dessous (il ne sert qu'une fois, effacé après l'échange).
# 3. node scripts/meta-publish.mjs setup
#    → échange longue durée + jeton de PAGE (n'expire pas) écrits ici même.
# 4. node scripts/meta-publish.mjs smoke   (post non publié créé puis supprimé)

FB_APP_ID=
FB_APP_SECRET=
FB_USER_TOKEN=

# ── Remplis par `setup` (ou à la main si tu as déjà un jeton de PAGE) ─────────
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Facultatif — version de l'API Graph (défaut : v21.0)
# FB_GRAPH_VERSION=v21.0
